import requests
from bs4 import BeautifulSoup
import re


def handler(pd: "pipedream"):
    url = pd.steps["trigger"]["event"]["message"]["text"].strip()

    headers = {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) "
            "Chrome/124.0.0.0 Safari/537.36"
        ),
        "Accept-Language": "en-US,en;q=0.9",
    }

    resp = requests.get(url, headers=headers, timeout=20)
    resp.raise_for_status()

    soup = BeautifulSoup(resp.text, "html.parser")

    for tag in soup(["nav", "footer", "aside", "script", "style", "noscript", "header"]):
        tag.decompose()

    container = (
        soup.find("main")
        or soup.find(attrs={"role": "main"})
        or soup.find("article")
        or soup.body
        or soup
    )

    target_tags = ["h1", "h2", "h3", "h4", "p", "li", "div"]
    seen = set()
    chunks = []

    for el in container.find_all(target_tags):
        if el.name == "div":
            has_block_child = el.find(["p", "li", "div", "ul", "ol", "table"])
            if has_block_child:
                continue

        text = el.get_text(separator=" ", strip=True)
        if not text:
            continue

        key = text.lower()
        if key in seen:
            continue
        seen.add(key)

        chunks.append(text)

    cleaned = "\n".join(chunks)
    cleaned = re.sub(r"[ \t]+", " ", cleaned)
    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned).strip()

    return {
        "url": url,
        "description": cleaned,
        "length": len(cleaned),
    }
